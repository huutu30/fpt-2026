    function getCookie(name) {
        var parts = document.cookie.split('; ');
        for (var i = 0; i < parts.length; i++) {
            var eq = parts[i].indexOf('=');
            if (eq > -1 && parts[i].substring(0, eq) === name) {
                return decodeURIComponent(parts[i].substring(eq + 1));
            }
        }
        return '';
    }

    function getAffSid() {
        try {
            var params = new URLSearchParams(window.location.search);
            var q = params.get('aff_sid');
            if (q) return q;
        } catch (e) {}
        return getCookie('_aff_sid');
    }

    var affSid = getAffSid();
    if (!affSid) return;

    var storageKey = 'aff_info_' + affSid;

    function renderSaleman(d) {
        if (!d) return;
        $('[data-saleman="email"]').text(d.Email || '');
        $('[data-saleman="phone"]').text(d.PhoneNumber || '');
        $('[data-saleman="name"]').text(d.SaleName || '');
        $('[data-saleman="branch"]').text(d.BranchFullName || '');

        if (d.PhoneNumber) {
            $('[data-saleman-tel]').attr('href', 'tel:' + d.PhoneNumber);
        }
        $('.js-saleman-box').show();
    }

    $(document).ready(function() {
        // Hit sessionStorage trước — skip AJAX nếu đã có trong cùng tab
        try {
            var cached = sessionStorage.getItem(storageKey);
            if (cached) {
                var parsed = JSON.parse(cached);
                if (parsed && parsed.Email) {
                    renderSaleman(parsed);
                    return;
                }
            }
        } catch (e) {}

        $.ajax({
            url: API_URL,
            type: 'POST',
            data: { aff_sid: affSid },
            timeout: 5000,
            success: function(response) {
                if (response && response.success && response.data) {
                    renderSaleman(response.data);
                    try {
                        sessionStorage.setItem(storageKey, JSON.stringify(response.data));
                    } catch (e) {}
                }
            },
            error: function(jqXHR, textStatus) {
                console.log('Saleman AJAX: ' + textStatus);
            }
        });
    });
})();
</script>

