    <!-- Modal gioi thieu ban be -->
    <!-- Loading -->
    <div id="loading" class="screen_loading loading_c" style="display: none;">
        <div class="spinner"></div>
    </div>

    <!-- .end Loading -->

    <!-- Loading style -->
    <style>
        .screen_loading { 
            position: fixed; top: 0; left: 0; 
            width: 100vw; height: 100vh; background: rgba(0, 0, 0, 0.6); z-index: 1100; 
            display: flex;
            flex-direction: column; justify-content: center; align-items: center; 
        }
        .screen_loading .spinner { border: 3px solid rgba(0, 0, 0, 0.7); border-top: 2px solid #fff; border-radius: 50%; width: 50px; height: 50px; animation: spin 1s linear infinite; }
        .screen_loading .text-load { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); color: #fff; font-weight: 300; font-size: 14px; }
        .screen_loading.shown { display: flex !important; }
        @keyframes  spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
    </style>
    <!-- .end Loading style -->

    <script>
		/**
		 * Use:
		 * C1: Dùng true, false
		 * C2: Dùng class 'shown', 'hiden'
		 */
		function activeLoading(status = '') {
			// 
			var sc_loading;
			if ($('.loading_c').length) {
				sc_loading = $('.loading_c');
				// 
				if (typeof(status) == 'boolean') {
					status == true ? sc_loading.show() : sc_loading.hide();
				} else {
					if (status == "shown") {
						sc_loading.addClass('shown');
					} else {
						sc_loading.removeClass('shown');
						sc_loading.hide();
					}
				}
			}
		}
    </script>
